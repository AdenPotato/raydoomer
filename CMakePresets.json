{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-test",
      "displayName": "Native - headless tests",
      "description": "Host compiler. Builds and runs the test suite. No raylib, no window, no GPU.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-test",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-game",
      "displayName": "Cross - Windows game binary",
      "description": "MinGW-w64 cross-compile. Produces doomer.exe for the Windows host.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-game",
      "toolchainFile": "${sourceDir}/cmake/toolchain-mingw64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-test", "configurePreset": "linux-test" },
    { "name": "windows-game", "configurePreset": "windows-game" }
  ],
  "testPresets": [
    {
      "name": "linux-test",
      "configurePreset": "linux-test",
      "output": { "outputOnFailure": true }
    }
  ]
}
