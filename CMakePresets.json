{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-test",
      "displayName": "Native - headless tests",
      "description": "Host compiler. Builds and runs the test suite. No raylib, no window, no GPU.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-test",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Cross - Windows game binary (debug)",
      "description": "MinGW-w64 cross-compile, Debug. Day-to-day build: asserts live, debug view on.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "toolchainFile": "${sourceDir}/cmake/toolchain-mingw64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Cross - Windows game binary (release)",
      "description": "MinGW-w64 cross-compile, Release. The shipping build: asserts compiled out, debug view off.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "toolchainFile": "${sourceDir}/cmake/toolchain-mingw64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-test", "configurePreset": "linux-test" },
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" }
  ],
  "testPresets": [
    {
      "name": "linux-test",
      "configurePreset": "linux-test",
      "output": { "outputOnFailure": true }
    }
  ]
}
